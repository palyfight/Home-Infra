# Start with DRY_RUN=true. Watch `docker logs -f media-janitor` to check what it
# would delete, then set it to false and run `docker compose up -d`.
DRY_RUN=true

# The Plex genre that marks media for deletion.
# Caution: labelarr writes TMDB keywords into genres, so a film whose TMDB
# keywords include "trash" would also match. Check the dry-run output.
TRASH_TAG=Trash
TAG_FIELDS=genre

POLL_INTERVAL=300            # seconds between checks
MAX_DELETES_PER_RUN=25       # safety cap if many items are tagged by mistake
ADD_IMPORT_EXCLUSION=true    # stop Radarr/Sonarr lists and Jellyseerr from re-adding it
LOG_LEVEL=INFO

# PLEX (required). In Plex, turn on Settings > Library > "Allow media deletion".
PLEX_URL=http://localhost:32400
PLEX_TOKEN={PLEX_TOKEN}

# RADARR / SONARR (Settings > General > API Key)
RADARR_URL=http://localhost:7878
RADARR_API_KEY={RADARR_API_KEY}
SONARR_URL=http://localhost:8989
SONARR_API_KEY={SONARR_API_KEY}

# JELLYFIN (Dashboard > API Keys)
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY={JELLYFIN_API_KEY}

# QBITTORRENT (WebUI login)
QBIT_URL=http://localhost:8080
QBIT_USER={QBIT_USER}
QBIT_PASS={QBIT_PASS}
