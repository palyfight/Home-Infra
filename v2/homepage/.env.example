# GENERAL
TZ=America/Toronto # Set your timezone
PUID=1000
PGID=1000

# SPEEDTEST CONFIGURATION
SPEEDTEST_APP_KEY={YOUR_BASE64_APP_KEY} # Replace with your actual Speedtest app key

# SECRETS FOR services.yaml (referenced as {{HOMEPAGE_VAR_...}})
HOMEPAGE_VAR_IMMICH_KEY={IMMICH_API_KEY}          # Immich: Account Settings > API Keys
HOMEPAGE_VAR_JELLYSEERR_KEY={JELLYSEERR_API_KEY}  # Jellyseerr: Settings > General > API Key
HOMEPAGE_VAR_PLEX_TOKEN={PLEX_TOKEN}              # https://support.plex.tv/articles/204059436
HOMEPAGE_VAR_JELLYFIN_KEY={JELLYFIN_API_KEY}      # Jellyfin: Dashboard > API Keys
HOMEPAGE_VAR_SONARR_KEY={SONARR_API_KEY}          # Settings > General > API Key
HOMEPAGE_VAR_RADARR_KEY={RADARR_API_KEY}          # Settings > General > API Key
HOMEPAGE_VAR_PROWLARR_KEY={PROWLARR_API_KEY}      # Settings > General > API Key
HOMEPAGE_VAR_TAUTULLI_KEY={TAUTULLI_API_KEY}      # Settings > Web Interface > API Key
HOMEPAGE_VAR_SPEEDTEST_KEY={SPEEDTEST_API_TOKEN}  # Speedtest Tracker: General > API Tokens
HOMEPAGE_VAR_QBIT_USER={QBIT_USER}
HOMEPAGE_VAR_QBIT_PASS={QBIT_PASS}
